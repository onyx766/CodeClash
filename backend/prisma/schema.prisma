generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MASTER
}

/// Account standing. BANNED is enforced at authentication time (see
/// JwtStrategy and AuthService.login), not merely displayed in the admin UI.
enum UserStatus {
  ACTIVE
  BANNED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
  EXPERT
}

/// Authoring lifecycle. DRAFT is freely editable; PUBLISHED is the only state
/// the match/challenge pools draw from; ARCHIVED is retired but kept so that
/// historical MatchChallenges/Submissions still resolve.
enum ChallengeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Only FUNCTION is implemented. STANDARD_IO is reserved so the column and the
/// runner protocol do not have to change when stdin/stdout problems land.
enum ChallengeProblemType {
  FUNCTION
  STANDARD_IO
}

enum JudgeMethod {
  EXACT
  DEEP_EQUAL
  CUSTOM_CHECKER
  REFERENCE
}

enum ChallengeCreationMode {
  MANUAL
  AI
  JSON_IMPORT
}

/// Result of the last server-run validation job. Reset to NOT_CHECKED whenever
/// anything that can change judging is edited - see
/// AdminChallengesService.applyValidationInvalidation.
enum ChallengeValidationStatus {
  NOT_CHECKED
  PASSED
  FAILED
}

enum RoomStatus {
  WAITING
  READY
  IN_MATCH
  FINISHED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MatchStatus {
  PENDING
  // Quick Match only: match has been created and is waiting on both
  // participants to confirm readiness (see MatchParticipant.readyAt).
  // Private-room matches never enter these two states - MatchesService
  // creates them directly as IN_PROGRESS.
  PENDING_READY
  READY
  IN_PROGRESS
  FINISHED
  CANCELLED
  // Never written by the five-challenge battle engine. Kept only because
  // dropping a value from a Postgres enum is a destructive migration.
  ABANDONED
  EXPIRED
}

/// Why a match left IN_PROGRESS. Set exactly once, by MatchFinalizationService.
enum MatchFinishReason {
  ALL_CHALLENGES_SOLVED
  PLAYER_GAVE_UP
  TIME_EXPIRED
  SYSTEM_CANCELLED
  // Reserved for a future disconnect-grace forfeit policy. A WebSocket
  // disconnect never ends a match today.
  OPPONENT_DISCONNECTED
}

enum MatchResultType {
  WIN
  DRAW
}

/// Per-player state of one of the match's challenges.
enum MatchChallengeStatus {
  NOT_STARTED
  ATTEMPTING
  SOLVED
}

/// QUEUED/RUNNING are the only non-final states. Only ACCEPTED can mark a
/// MatchChallengeProgress SOLVED - see RunnerResultService.
enum SubmissionStatus {
  QUEUED
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  RUNTIME_ERROR
  TIME_LIMIT
  MEMORY_LIMIT
  OUTPUT_LIMIT
  SYSTEM_ERROR
}

enum MatchType {
  QUICK_MATCH
  PRIVATE_ROOM
  // PRIVATE_RANKED reserved for future use - not implemented yet.
}

enum MatchRiskStatus {
  NORMAL
  SUSPICIOUS
  BLOCKED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  hostedRooms  Room[]   @relation("host")
  updatedAt    DateTime @updatedAt

  // ---- account standing (admin user management) -------------------------
  status      UserStatus @default(ACTIVE)
  bannedAt    DateTime?
  banReason   String?
  /// Who applied the ban. Kept for the audit trail; nulled if that admin's
  /// account is ever deleted.
  bannedById  String?
  bannedBy    User?      @relation("userBans", fields: [bannedById], references: [id], onDelete: SetNull)
  bannedUsers User[]     @relation("userBans")

  /// Last time this account authenticated (login or token refresh). Null for
  /// an account that has never signed in - the admin UI shows "Never" rather
  /// than inventing a date.
  lastActiveAt DateTime?

  /// Any access or refresh token issued before this instant is refused. Set
  /// when an admin resets the password, so the reset actually ends sessions
  /// that are already out there - access tokens carry no expiry of their own.
  sessionsRevokedAt DateTime?

  // Approximate location derived from IP geolocation at registration/login.
  // Best-effort and may be null - never treat as precise or authoritative.
  country  String?
  region   String?
  city     String?
  timezone String?

  rooms       RoomPlayer[]
  submissions Submission[]
  // matches as winner relation
  wonMatches  Match[]      @relation("winner")

  matchChallengeProgress MatchChallengeProgress[]

  sentInvitations     RoomInvitation[] @relation("invitationInviter")
  receivedInvitations RoomInvitation[] @relation("invitationInvitee")

  profile           UserProfile?
  stats             UserStats?
  preferences       UserPreference?
  ratingHistory     RatingHistory[]
  matchParticipants MatchParticipant[]

  createdChallenges Challenge[] @relation("challengeAuthor")

  @@index([status])
  @@index([createdAt])
}

model UserProfile {
  id     String @id @default(uuid())
  userId String @unique

  displayName String?
  bio         String?
  avatarUrl   String?
  location    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserStats {
  id     String @id @default(uuid())
  userId String @unique

  // Ranked stats - only ever touched by rating-eligible (Quick Match) results.
  rating           Int @default(1200)
  wins             Int @default(0)
  losses           Int @default(0)
  totalScore       Int @default(0)
  bestStreak       Int @default(0)
  currentStreak    Int @default(0)
  matchesPlayed    Int @default(0)
  challengesSolved Int @default(0)
  coins            Int @default(0)
  xp               Int @default(0)

  draws Int @default(0)

  // Casual stats - private room (PRIVATE_ROOM) results only. Never affects rating.
  casualWins          Int @default(0)
  casualLosses        Int @default(0)
  casualDraws         Int @default(0)
  casualMatchesPlayed Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserPreference {
  id     String @id @default(uuid())
  userId String @unique

  favoriteLanguages String[] @default([])
  favoriteTopics    String[] @default([])

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Challenge {
  id          String     @id @default(uuid())
  title       String
  /// URL-friendly identifier used by the player-facing API
  /// (GET /api/challenges/:slug). Unique across every status.
  slug        String     @unique
  description String
  difficulty  Difficulty @default(EASY)

  problemType ChallengeProblemType @default(FUNCTION)

  // ---- function contract -------------------------------------------------
  functionName String
  /// [{ name, type }] - ordered. Test-case inputs are objects keyed by these
  /// names, and the runner rebuilds the positional argument list from this
  /// order. Never trusted from the browser: validated by validateContract().
  parameters   Json   @default("[]")
  returnType   String @default("any")
  starterCode  String

  // ---- judging -----------------------------------------------------------
  judgeMethod JudgeMethod @default(DEEP_EQUAL)

  /// Executable challenge code. Only ever leaves the database towards the
  /// isolated code runner - never towards a player-facing response, and never
  /// executed inside the NestJS process.
  customCheckerCode     String?
  referenceSolutionCode String?
  testGeneratorCode     String?

  // ---- execution limits (per test case, enforced by the runner) ----------
  timeLimitMs   Int @default(2000)
  memoryLimitMb Int @default(128)
  outputLimitKb Int @default(64)

  /// Suggested solving time in seconds, shown in the admin console. Battles do
  /// not use it - a match has one overall clock (MATCH_DURATION_MINUTES). NOT
  /// an execution limit either - see timeLimitMs above.
  timeLimitSeconds Int @default(300)

  // ---- lifecycle ---------------------------------------------------------
  status       ChallengeStatus       @default(DRAFT)
  creationMode ChallengeCreationMode @default(MANUAL)

  validationStatus      ChallengeValidationStatus @default(NOT_CHECKED)
  validatedAt           DateTime?
  /// Serialised checks from the last validation run, for the admin UI.
  validationChecks      Json?
  /// Hash of every judging-relevant field at the moment validation passed.
  /// publish() recomputes it and refuses if it moved, so "validate -> edit a
  /// hidden test -> publish" cannot slip through even if an update path
  /// forgets to reset validationStatus.
  validationFingerprint String?

  createdById String?
  createdBy   User?   @relation("challengeAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  testCases       ChallengeTestCase[]
  matchChallenges MatchChallenge[]
  submissions     Submission[]
  tags            ChallengeTag[]

  @@index([status])
}

model ChallengeTag {
  id    String @id @default(uuid())
  /// Lowercase, hyphenated. The display label lives in `label`.
  slug  String @unique
  label String

  challenges Challenge[]

  createdAt DateTime @default(now())
}

model ChallengeTestCase {
  id          String    @id @default(uuid())
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  challengeId String

  /// JSON object keyed by function-contract parameter name, e.g.
  /// { "nums": [2,7,11,15], "target": 9 }. Stored structured rather than as a
  /// string so the runner never has to eval() an input.
  input          Json
  /// Null is legitimate for CUSTOM_CHECKER (the checker decides) and for
  /// generated tests whose expectation comes from the reference solution.
  expectedOutput Json?

  isHidden Boolean @default(true)
  order    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, order])
  @@index([challengeId])
}

model Room {
  id         String     @id @default(uuid())
  code       String     @unique
  host       User       @relation("host", fields: [hostId], references: [id])
  hostId     String
  status     RoomStatus @default(WAITING)
  maxPlayers Int        @default(2)
  createdAt  DateTime   @default(now())
  // Waiting rooms with no match yet are pruned once past this. Never
  // enforced once a Match exists - see RoomsService.isExpired.
  expiresAt  DateTime?

  players     RoomPlayer[]
  match       Match?
  invitations RoomInvitation[]
}

model RoomInvitation {
  id     String @id @default(uuid())
  room   Room   @relation(fields: [roomId], references: [id])
  roomId String

  inviter   User   @relation("invitationInviter", fields: [inviterId], references: [id])
  inviterId String
  invitee   User   @relation("invitationInvitee", fields: [inviteeId], references: [id])
  inviteeId String

  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@index([inviteeId, status])
  @@index([roomId, inviteeId, status])
}

model RoomPlayer {
  id       String   @id @default(uuid())
  room     Room     @relation(fields: [roomId], references: [id])
  roomId   String
  user     User     @relation(fields: [userId], references: [id])
  userId   String
  isReady  Boolean  @default(false)
  joinedAt DateTime @default(now())
}

/// One battle between two players over the same MatchChallenge set. Quick
/// Match and private rooms share this model and the whole battle engine; they
/// differ only in `type` / `ratingEligible`.
model Match {
  id       String      @id @default(uuid())
  // Private-room matches only. Quick Match matches have no Room.
  room     Room?       @relation(fields: [roomId], references: [id])
  roomId   String?     @unique
  status   MatchStatus @default(PENDING)
  winnerId String?
  winner   User?       @relation("winner", fields: [winnerId], references: [id])

  /// Null until the match leaves IN_PROGRESS. A DRAW has no winnerId.
  finishReason MatchFinishReason?
  resultType   MatchResultType?

  startedAt  DateTime?
  /// startedAt + MATCH_DURATION_MINUTES. The server clock is authoritative;
  /// MatchTimeoutService resolves the match once this passes.
  expiresAt  DateTime?
  finishedAt DateTime?

  // Quick Match only: deadline for both MatchParticipant rows to have
  // readyAt set before the match is auto-cancelled. Null for private rooms.
  readyDeadline DateTime?

  // Anti-rigging: server-determined match type and rating eligibility. Never
  // settable by client input - see MatchesService/RatingService.
  type              MatchType @default(PRIVATE_ROOM)
  ratingEligible    Boolean   @default(false)
  ratingReason      String?
  ratingProcessedAt DateTime?

  // Future anti-cheat risk model placeholders - unused for now, never written to.
  riskScore  Int?
  riskStatus MatchRiskStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ratingHistory RatingHistory[]
  participants  MatchParticipant[]
  challenges    MatchChallenge[]
  submissions   Submission[]

  @@index([status, expiresAt])
}

/// A player in a match - every match type, private rooms included.
model MatchParticipant {
  id String @id @default(uuid())

  matchId String
  userId  String

  /// Quick Match ready confirmation. Unused by private rooms.
  readyAt DateTime?

  // Rating snapshot read from UserStats when the match is created - never
  // trust a client-provided rating.
  ratingBefore Int
  ratingAfter  Int?

  gaveUpAt DateTime?
  joinedAt DateTime  @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
}

/// One of the challenges selected for a match. Selected once, server-side,
/// when the match starts; both players share the same rows.
model MatchChallenge {
  id String @id @default(uuid())

  matchId     String
  challengeId String

  /// 1-based display order. Players may solve in any order.
  position Int

  createdAt DateTime @default(now())

  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  challenge Challenge @relation(fields: [challengeId], references: [id])

  progress    MatchChallengeProgress[]
  submissions Submission[]

  @@unique([matchId, challengeId])
  @@unique([matchId, position])
  @@index([matchId])
}

/// A player's state on one MatchChallenge. Created eagerly for both players
/// when the match starts. Only RunnerResultService writes SOLVED, and only
/// once: solvedAt/solveDurationMs/bestSubmissionId never change afterwards.
model MatchChallengeProgress {
  id String @id @default(uuid())

  matchChallengeId String
  userId           String

  status MatchChallengeStatus @default(NOT_STARTED)

  /// Scored submissions made (Run Tests does not count).
  attempts Int @default(0)

  firstAttemptAt  DateTime?
  solvedAt        DateTime?
  /// solvedAt - Match.startedAt. Summed for the timeout tie-break.
  solveDurationMs Int?

  /// The first ACCEPTED submission - the one that set solvedAt.
  bestSubmissionId String?     @unique
  bestSubmission   Submission? @relation("progressBestSubmission", fields: [bestSubmissionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchChallenge MatchChallenge @relation(fields: [matchChallengeId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchChallengeId, userId])
  @@index([userId])
}

/// A scored attempt, judged by the isolated runner against public AND hidden
/// tests. Run Tests (public tests only) never writes one.
model Submission {
  id     String @id @default(uuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  challenge   Challenge @relation(fields: [challengeId], references: [id])
  challengeId String

  match            Match?          @relation(fields: [matchId], references: [id])
  matchId          String?
  matchChallenge   MatchChallenge? @relation(fields: [matchChallengeId], references: [id])
  matchChallengeId String?

  sourceCode String @db.Text
  language   String @default("javascript")

  status SubmissionStatus @default(QUEUED)

  /// Null until the runner verdict is recorded.
  passedTests  Int?
  totalTests   Int?
  runtimeMs    Int?
  memoryUsedKb Int?
  runnerJobId  String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  bestFor MatchChallengeProgress? @relation("progressBestSubmission")

  @@index([matchChallengeId, userId])
  @@index([matchId, status])
  @@index([userId, createdAt])
}

// Only ever populated for ratingEligible matches - see RatingService. Private
// room (casual) results never create rows here.
model RatingHistory {
  id String @id @default(uuid())

  userId  String
  matchId String
  user    User   @relation(fields: [userId], references: [id])
  match   Match  @relation(fields: [matchId], references: [id])

  previousRating Int
  newRating      Int
  change         Int

  createdAt DateTime @default(now())

  @@unique([userId, matchId])
  @@index([userId, createdAt])
}

model Job {
  id        String      @id
  createdAt DateTime    @default(now())
  metadata  Json?
  status    String      @default("ENQUEUED")
  exitCode  Int?
  results   JobResult[]
}

model JobResult {
  id        String   @id @default(uuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  payload   Json
  createdAt DateTime @default(now())
}
