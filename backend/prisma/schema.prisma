generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLAYER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum RoomStatus {
  WAITING
  READY
  IN_MATCH
  FINISHED
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  FINISHED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  role         Role     @default(PLAYER)
  rating       Int      @default(1200)
  totalScore   Int      @default(0)
  wins         Int      @default(0)
  losses       Int      @default(0)
  createdAt    DateTime @default(now())
  hostedRooms  Room[]   @relation("host")
  updatedAt    DateTime @updatedAt

  rooms        RoomPlayer[]
  submissions  Submission[]
  // matches as winner relation
  wonMatches   Match[]  @relation("winner")
}

model Challenge {
  id              String               @id @default(uuid())
  title           String
  description     String
  difficulty      Difficulty           @default(EASY)
  starterCode     String
  functionName    String
  timeLimitSeconds Int                 @default(300)
  isPublished     Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  testCases       ChallengeTestCase[]
  rounds          Round[]
}

model ChallengeTestCase {
  id             String   @id @default(uuid())
  challenge      Challenge @relation(fields: [challengeId], references: [id])
  challengeId    String
  input          String
  expectedOutput String
  isHidden       Boolean  @default(false)
}

model Room {
  id        String       @id @default(uuid())
  code      String       @unique
  host      User         @relation("host", fields: [hostId], references: [id])
  hostId    String
  status    RoomStatus   @default(WAITING)
  maxPlayers Int         @default(2)
  createdAt DateTime     @default(now())

  players   RoomPlayer[]
  match     Match?
}

model RoomPlayer {
  id       String  @id @default(uuid())
  room     Room    @relation(fields: [roomId], references: [id])
  roomId   String
  user     User    @relation(fields: [userId], references: [id])
  userId   String
  isReady  Boolean @default(false)
  joinedAt DateTime @default(now())
}

model Match {
  id                 String     @id @default(uuid())
  room               Room       @relation(fields: [roomId], references: [id])
  roomId             String     @unique
  status             MatchStatus @default(PENDING)
  currentRoundNumber Int        @default(0)
  totalRounds        Int        @default(3)
  winnerId           String?    
  winner             User?      @relation("winner", fields: [winnerId], references: [id])
  startedAt          DateTime?
  finishedAt         DateTime?

  rounds             Round[]
}

model Round {
  id          String   @id @default(uuid())
  match       Match    @relation(fields: [matchId], references: [id])
  matchId     String
  challenge   Challenge @relation(fields: [challengeId], references: [id])
  challengeId String
  roundNumber Int
  startedAt   DateTime?
  endsAt      DateTime?
  finishedAt  DateTime?

  submissions Submission[]
}

model Submission {
  id         String   @id @default(uuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  round      Round    @relation(fields: [roundId], references: [id])
  roundId    String
  code       String   @db.Text
  passedTests Int
  totalTests Int
  runtimeMs  Int
  score      Int
  submittedAt DateTime @default(now())
}

model Job {
  id         String   @id
  createdAt  DateTime @default(now())
  metadata   Json?
  status     String   @default("ENQUEUED")
  exitCode   Int?
  results    JobResult[]
}

model JobResult {
  id        String   @id @default(uuid())
  job       Job      @relation(fields: [jobId], references: [id])
  jobId     String
  payload   Json
  createdAt DateTime @default(now())
}
