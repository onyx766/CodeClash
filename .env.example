NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codeclash

REDIS_HOST=localhost
REDIS_PORT=6379

# Secrets for signing JWTs. Generate with: openssl rand -base64 48
# Use two DIFFERENT values so a leaked access secret cannot be used to mint refresh tokens.
JWT_ACCESS_SECRET=replace_me_with_a_long_random_value
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins. Add a LAN/VPN IP here
# (e.g. http://localhost:3000,http://192.168.1.20:3000) to browse the
# frontend from another device/interface in development.
FRONTEND_URL=http://localhost:3001

CODE_RUNNER_URL=http://localhost:5000

# Number of reverse proxy hops (Cloudflare/Nginx/etc.) in front of the API.
# Leave at 0 in local dev. Only raise this to match a real, trusted proxy
# chain - it controls which X-Forwarded-For entries Express will trust.
TRUST_PROXY_HOPS=0

# IP-based geolocation (country/region/city/timezone only - never exact
# coordinates or street address). Used to enrich the User record on
# registration and login; failures are always non-fatal to auth.
# Supported providers: ip-api (ip-api.com, no key needed) | ipapi (ipapi.co)
GEOLOCATION_PROVIDER=ip-api
GEOLOCATION_API_KEY=
GEOLOCATION_TIMEOUT_MS=2000

# Dev-only: since localhost/private IPs can't be geolocated, optionally set a
# public IP here to test the feature locally. Ignored when NODE_ENV=production.
GEOLOCATION_DEV_IP=

# Quick Match matchmaking. Rating-tolerance widening schedule (in rating
# points) by time spent waiting - all optional, shown here at their defaults.
MATCHMAKING_RANGE_INITIAL=100
MATCHMAKING_RANGE_10S=150
MATCHMAKING_RANGE_20S=250
MATCHMAKING_RANGE_30S=400
MATCHMAKING_RANGE_MAX=600

# Background pairing loop cadence (ms) and how many oldest waiting players it
# processes per tick.
MATCHMAKING_TICK_MS=1000
MATCHMAKING_MAX_PER_TICK=50

# How long (seconds) a claimed pair is reserved in Redis while the ranked
# Match row is being created in PostgreSQL.
MATCHMAKING_RESERVATION_TTL_SECONDS=20

# A searching player is dropped from the queue if nothing has been heard from
# them (socket connect or a status poll) for this long (ms). Covers both a
# WebSocket disconnect grace period and general queue staleness.
MATCHMAKING_STALE_TIMEOUT_MS=10000

# Soft repeat-opponent avoidance window (seconds) - prefer a different
# opponent than one played this recently, when an alternative exists.
MATCHMAKING_RECENT_OPPONENT_TTL_SECONDS=1800

# How long (seconds) both players have to confirm ready after a Quick Match
# opponent is found before the match is auto-cancelled.
MATCH_READY_TIMEOUT_SECONDS=10
