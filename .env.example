# CodeClash configuration.
#
# docker compose: `./scripts/init-env.sh` writes ./.env from this template with
#                 generated secrets (or copy it to .env and fill the secrets in).
# Local dev:      copy it to backend/.env and adjust the hosts/ports
#                 (see docs/development.md).
#
# Every variable below has a safe default unless marked REQUIRED.

# --- Secrets (REQUIRED) -------------------------------------------------------
# Generate each with: openssl rand -hex 32
# Use different values for the two JWT secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Shared by the API, the code runner and its workers to sign judge verdicts.
RUNNER_SECRET=
# PostgreSQL password (docker compose). Keep it URL-safe (hex is fine).
POSTGRES_PASSWORD=

# --- Seed data (first start only) --------------------------------------------
# A database without users is seeded with master@codeclash.local (MASTER),
# admin@codeclash.local (ADMIN), demo players player1..5@codeclash.local and
# the starter challenge set. Change these before exposing the stack.
SEED_ADMIN_PASSWORD=
SEED_PLAYER_PASSWORD=
SEED_DEMO_PLAYERS=true

# --- Public URLs ---------------------------------------------------------------
# Origins allowed to call the API with cookies (comma-separated). Add every
# address people use to open the apps, e.g. http://192.168.1.20:3000
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
ADMIN_FRONTEND_URL=http://localhost:7662,http://127.0.0.1:7662
# Only needed when the API is NOT on port 4000 of the host serving the apps
# (e.g. behind a reverse proxy). Build-time values: rebuild after changing.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
NEXT_PUBLIC_PLAYER_APP_URL=

# --- HTTP / auth ---------------------------------------------------------------
# Secure cookies require HTTPS. Keep false for plain-HTTP deployments.
COOKIE_SECURE=false
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Number of trusted reverse-proxy hops in front of the API (0 = none).
TRUST_PROXY_HOPS=0
# Global rate limit per client address: THROTTLE_LIMIT requests per window.
# THROTTLE_LIMIT=300
# THROTTLE_TTL_MS=60000

# --- Code runner ---------------------------------------------------------------
# Validate seeded/imported challenges in the sandbox automatically at startup.
AUTO_VALIDATE_CHALLENGES=true
# Image every submission runs in, and jobs each worker runs at once.
SANDBOX_IMAGE=node:22-alpine
WORKER_CONCURRENCY=2

# --- Local development only (ignored by docker compose) ------------------------
# NODE_ENV=development
# PORT=4000
# DATABASE_URL=postgresql://codeclash:<POSTGRES_PASSWORD>@localhost:5432/codeclash
# REDIS_HOST=localhost
# REDIS_PORT=6379
# CODE_RUNNER_URL=http://localhost:5000

# --- Matchmaking & battles (optional tuning) -----------------------------------
# MATCHMAKING_RANGE_INITIAL=100
# MATCHMAKING_RANGE_10S=150
# MATCHMAKING_RANGE_20S=250
# MATCHMAKING_RANGE_30S=400
# MATCHMAKING_RANGE_MAX=600
# MATCHMAKING_TICK_MS=1000
# MATCH_READY_TIMEOUT_SECONDS=10
# MATCH_CHALLENGE_COUNT=5
# MATCH_EASY_COUNT=2
# MATCH_MEDIUM_COUNT=2
# MATCH_HARD_COUNT=1
# MATCH_DURATION_MINUTES=30
# MATCH_REQUIRE_VALIDATED_CHALLENGES=true

# --- Optional integrations -----------------------------------------------------
# IP geolocation for user profiles (off by default; enabling it sends each
# player's IP address to the provider): none | ip-api | ipapi
# GEOLOCATION_PROVIDER=none
# GEOLOCATION_API_KEY=
# AI challenge generation in the admin console (disabled when unset).
# AI_SERVICE_URL=
# AI_SERVICE_API_KEY=
